{
  "name": "gate-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker-main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "demo:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "data:import": "node --env-file-if-exists=.env --import tsx scripts/import.ts",
    "audit:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-audit.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
