          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:_-]{8,128}$"
          }
        },
        "required": [
          "expectedVersion",
          "runId",
          "report",
          "request_id",
          "idempotency_key"
        ],
        "additionalProperties": false
