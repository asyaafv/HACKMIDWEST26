                      "maxLength": 200
                    },
                    "sourceHash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "contentHash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "domain",
                    "sourceId",
                    "sourceHash",
                    "contentHash"
                  ],
                  "additionalProperties": false
                }
              },
              "links": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "fromId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "toId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "basisPointer": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "relationship": {
                      "type": "string",
                      "enum": [
                        "ISSUE_TICKET",
                        "TICKET_ACCOUNT",
                        "DOCUMENT_TICKET",
                        "EXPLICIT_REFERENCE"
                      ]
                    }
                  },
                  "required": [
                    "fromId",
                    "toId",
                    "basisPointer",
                    "relationship"
                  ],
                  "additionalProperties": false
                }
              },
              "unresolvedQuestions": {
                "default": [],
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            },
            "required": [
              "sources",
              "links",
              "unresolvedQuestions"
            ],
            "additionalProperties": false
