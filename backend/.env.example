# Gate reviews existing records. Database secrets belong in your ignored .env.
DATABASE_URL=postgresql://gate:gate_local_only@127.0.0.1:55432/gate
HOST=127.0.0.1
PORT=8000
APP_MODE=sandbox
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000

# Optional DevRev bridge: configure all three together in the host secret store.
# Team: https://app.devrev.ai/maplestudio-playground-10-193711
# DEVREV_MCP_ORG_ID=17WZM4zcjj
# DEVREV_MCP_EMAIL=<connector token owner's email>
# DEVREV_MCP_CREDENTIAL_ID=<existing scoped Gate AGENT credential ID>

# The launcher resolves these IDs automatically; hosted no-login demos configure both.
# DEMO_WORKSPACE_ORG_ID=<organization UUID>
# DEMO_WORKSPACE_PRINCIPAL_ID=<active FINANCE principal UUID>

# Optional outbound DevRev trust assessments (distinct from the inbound MCP identity bridge).
# Keep disabled while the webhook is being deployed/registered. Never commit actual secrets.
# DEVREV_API_TOKEN=<private DevRev API token>
# DEVREV_TRUST_AGENT_ID=don:core:dvrv-us-1:devo/17WZM4zcjj:ai_agent/6
# DEVREV_TRUST_WEBHOOK_SECRET=<random private secret; npm run devrev:prepare generates this>
# DEVREV_TRUST_WEBHOOK_URL=https://hackmidwest26.onrender.com/v1/integrations/devrev/trust/webhook
# DEVREV_TRUST_WEBHOOK_ID=<returned by npm run devrev:register-webhook>
DEVREV_TRUST_ENABLED=false
DEVREV_TRUST_TIMEOUT_SECONDS=60
