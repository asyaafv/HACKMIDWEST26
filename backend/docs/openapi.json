          },
          "workflowStatus": {
            "type": "string",
            "enum": [
              "COLLECTING",
              "AWAITING_EVIDENCE",
              "AWAITING_CONSENT",
              "REJECTED",
              "AUTHORIZED",
              "EXECUTING",
              "RECONCILING",
              "COMPLETED",
              "FAILED",
              "CANCELLED",
              "EXPIRED"
            ]
          },
          "policyVerdict": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REVIEW",
              "REJECT"
            ]
          },
          "consentStatus": {
            "type": "string",
