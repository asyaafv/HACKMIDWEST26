          },
          "holdState": {
            "type": "string",
            "enum": [
              "HELD",
              "CAPTURED",
              "RELEASED"
            ]
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,11}$"
          },
          "operationKey": {
            "type": "string"
          },
          "receipt": {
            "anyOf": [
