{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://hackmidwest26.onrender.com/v1/:path*" },
    { "source": "/health", "destination": "https://hackmidwest26.onrender.com/health" },
    { "source": "/health/:path*", "destination": "https://hackmidwest26.onrender.com/health/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
